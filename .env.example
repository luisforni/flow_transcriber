# ── Whisper ────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
LANGUAGE=es
SEGMENT_DURATION=300
MAX_CHARS=20000
OUTPUT_DIR=out
HEADER_PROMPT_TEMPLATE=<<TRANSCRIPCION>>\n

# ── OLLAMA ─────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_SYSTEM_PROMPT=Eres un asistente experto en análisis de transcripciones de audio. Responde en español de forma clara y concisa. Cuando el usuario te proporcione una transcripción, analízala y responde sus preguntas sobre ella.

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# URL interna que Next.js usa para proxyar /api/* al backend
# En Docker: http://backend:8000
# En local:  http://localhost:8000
BACKEND_URL=http://localhost:8000
